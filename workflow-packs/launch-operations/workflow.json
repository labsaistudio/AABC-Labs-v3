{
  "id": "launch-operations",
  "title": "Launch Operations Workflow",
  "summary": "Prepare launch operations checkpoints, route plans, and proof artifacts.",
  "ecosystem": {
    "chain": "solana",
    "capabilities": [
      "sendai-solana-agent-kit",
      "solana-web3js",
      "jupiter-protocol",
      "raydium-protocol",
      "helius-protocol",
      "reown-wallet-connectivity"
    ],
    "frontierCapabilities": [
      "jupiter-developer-platform"
    ]
  },
  "steps": [
    {
      "key": "source-check",
      "intent": "Check launch sources and risk inputs.",
      "action": "read_state",
      "riskClass": "read_only",
      "signerMode": "prepare_only",
      "operationType": "read_state",
      "network": "testnet",
      "expectedArtifacts": ["source_check"]
    },
    {
      "key": "route-plan",
      "intent": "Prepare a route plan without broadcasting.",
      "action": "prepare_tx",
      "riskClass": "prepare_tx",
      "signerMode": "prepare_only",
      "operationType": "prepare_transfer",
      "network": "testnet",
      "estimatedValueUsd": 25,
      "frontierRuntime": true,
      "expectedArtifacts": ["route_plan"]
    }
  ],
  "sourcePackage": {
    "root": "source-package",
    "files": [
      {
        "path": "ops/route-planner.ts",
        "kind": "source",
        "sourcePath": "source/ops/route-planner.ts"
      },
      {
        "path": "ops/liquidity-checks.ts",
        "kind": "source",
        "sourcePath": "source/ops/liquidity-checks.ts"
      },
      {
        "path": "ops/jupiter-developer-platform-policy.ts",
        "kind": "source",
        "sourcePath": "source/ops/jupiter-developer-platform-policy.ts"
      },
      {
        "path": "ops/runbook.md",
        "kind": "doc",
        "sourcePath": "source/ops/runbook.md"
      }
    ]
  }
}
