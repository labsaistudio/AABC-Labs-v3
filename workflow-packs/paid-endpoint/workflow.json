{
  "id": "paid-endpoint",
  "title": "Paid Endpoint Workflow",
  "summary": "Build a paid endpoint contract with OpenAPI and proof artifacts.",
  "ecosystem": {
    "chain": "solana",
    "capabilities": [
      "solana-web3js",
      "spl-token-tooling",
      "reown-wallet-connectivity",
      "x402-solana-usdc"
    ],
    "qvacCapabilities": [
      "qvac-local-inference",
      "qvac-openai-compatible-http",
      "qvac-p2p-runtime",
      "qvac-local-rag"
    ]
  },
  "steps": [
    {
      "key": "endpoint-contract",
      "intent": "Generate endpoint discovery and pricing contract.",
      "action": "paid_endpoint",
      "riskClass": "generate_artifact",
      "signerMode": "prepare_only",
      "operationType": "endpoint_build",
      "network": "testnet",
      "qvacRuntime": true,
      "expectedArtifacts": ["openapi_spec"]
    },
    {
      "key": "preview",
      "intent": "Render endpoint board.",
      "action": "web_preview",
      "riskClass": "generate_artifact",
      "signerMode": "prepare_only",
      "operationType": "generate_source",
      "network": "testnet",
      "expectedArtifacts": ["html_preview"]
    }
  ],
  "sourcePackage": {
    "root": "source-package",
    "files": [
      {
        "path": "endpoint/route-handler.ts",
        "kind": "source",
        "sourcePath": "source/endpoint/route-handler.ts"
      },
      {
        "path": "endpoint/openapi.json",
        "kind": "spec",
        "sourcePath": "source/endpoint/openapi.json"
      },
      {
        "path": "endpoint/x402-settlement.ts",
        "kind": "source",
        "sourcePath": "source/endpoint/x402-settlement.ts"
      },
      {
        "path": "endpoint/qvac-runtime-policy.ts",
        "kind": "source",
        "sourcePath": "source/endpoint/qvac-runtime-policy.ts"
      }
    ]
  }
}
